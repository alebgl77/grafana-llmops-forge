# Normalize line endings: LF in the repo for all text, regardless of OS.
* text=auto eol=lf

*.py    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cff   text eol=lf
*.txt   text eol=lf

# Binary assets — never touch line endings, exclude from diffs.
*.png   binary
*.jpg   binary
*.gif   binary
*.webp  binary
